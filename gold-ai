function parseYahoo(j){
  const r=j.chart?.result?.[0]; if(!r?.timestamp) return []
  const q=r.indicators.quote[0]
  return r.timestamp.map((t,i)=>{
    const o=q.open?.[i],h=q.high?.[i],l=q.low?.[i],c=q.close?.[i]
    if([o,h,l,c].some(v=>v==null||isNaN(v))) return null
    return { timestamp:t*1000, open:+o.toFixed(2), high:+h.toFixed(2), low:+l.toFixed(2), close:+c.toFixed(2), price:+c.toFixed(2) }
  }).filter(Boolean)
}
async function fetchCandles(){
  for (const q of ['query1','query2']){
    try{
      const url=`https://${q}.finance.yahoo.com/v8/finance/chart/GC=F?interval=${TF.scalp.interval}&range=${TF.scalp.range}`
      const res=await fetch(url,{headers:{'User-Agent':'Mozilla/5.0'}})
      if(res.ok){ const a=parseYahoo(await res.json()); if(a.length>200) return a }
    }catch(_){}
  }
  throw new Error('No M5 data')
}

// ─────────────────────────────────────────────────────────────
//  BACKTESTER — the point of this whole file.
//  No look-ahead: at bar i we only see candles[0..i] and use the
//  bar's OWN timestamp as "now". Conservative fills: if a bar's
//  range touches BOTH stop and target, we assume STOP first.
//  Costs: spread + slippage applied to entry and exit.
//  Exit rule for the test: TP1 or SL, with a max-hold time stop.
// ─────────────────────────────────────────────────────────────
function backtest(candles, { maxHold=24, warmup=120 }={}){
  const trades=[]
  let i=warmup
  while (i < candles.length-1){
    const slice = candles.slice(0, i+1)
    const sig = analyse(slice, candles[i].timestamp)
    if (sig.skipped){ i++; continue }

    const dir=sig.direction
    const entry = dir==='BUY' ? sig.entry + SPREAD/2 + SLIPPAGE : sig.entry - SPREAD/2 - SLIPPAGE
    const sl=sig.sl, tp=sig.tp1
    const riskDist=Math.abs(entry-sl)
    if (riskDist<=0){ i++; continue }

    let outcomeR=null, exitIdx=null
    for (let j=i+1; j<Math.min(i+1+maxHold, candles.length); j++){
      const bar=candles[j]
      if (dir==='BUY'){
        if (bar.low<=sl){ outcomeR=-1; exitIdx=j; break }        // stop checked first (conservative)
        if (bar.high>=tp){ outcomeR=(tp-entry)/riskDist; exitIdx=j; break }
      } else {
        if (bar.high>=sl){ outcomeR=-1; exitIdx=j; break }
        if (bar.low<=tp){ outcomeR=(entry-tp)/riskDist; exitIdx=j; break }
      }
    }
    if (outcomeR==null){ // time stop: mark-to-close
      const exitPx=candles[Math.min(i+maxHold,candles.length-1)].close
      outcomeR = dir==='BUY' ? (exitPx-entry)/riskDist : (entry-exitPx)/riskDist
      exitIdx=Math.min(i+maxHold,candles.length-1)
    }
    // exit cost in R
    const costR=(SPREAD/2+SLIPPAGE)/riskDist
    outcomeR -= costR
    trades.push({ i, dir, score:sig.score, tier:sig.tier, regime:sig.regime, R:+outcomeR.toFixed(3) })
    i = exitIdx+1 // no overlapping trades
  }
  return stats(trades)
}

function stats(trades){
  if (!trades.length) return { trades:0, note:'No signals fired in this window.' }
  const Rs=trades.map(t=>t.R)
  const wins=Rs.filter(r=>r>0), losses=Rs.filter(r=>r<=0)
  const sum=Rs.reduce((a,b)=>a+b,0)
  const grossW=wins.reduce((a,b)=>a+b,0), grossL=Math.abs(losses.reduce((a,b)=>a+b,0))
  // max drawdown on cumulative R
  let peak=0, cum=0, mdd=0
  for(const r of Rs){ cum+=r; peak=Math.max(peak,cum); mdd=Math.min(mdd,cum-peak) }
  // by regime/tier breakdown
  const byKey=(fn)=>{ const m={}; for(const t of trades){ const k=fn(t); (m[k]??=[]).push(t.R) }
    return Object.fromEntries(Object.entries(m).map(([k,v])=>[k,{n:v.length,exp:+(v.reduce((a,b)=>a+b,0)/v.length).toFixed(3)}])) }
  return {
    trades:trades.length,
    winRate:+(wins.length/trades.length*100).toFixed(1)+'%',
    expectancyR:+(sum/trades.length).toFixed(3),
    profitFactor:grossL? +(grossW/grossL).toFixed(2) : Infinity,
    totalR:+sum.toFixed(2),
    maxDrawdownR:+mdd.toFixed(2),
    byRegime:byKey(t=>t.regime),
    byTier:byKey(t=>t.tier),
  }
}

