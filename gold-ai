const loadKey=()=>{ try{return JSON.parse(fs.readFileSync(STATE_FILE,'utf8')).lastKey}catch{return null} }
const saveKey=k=>{ try{fs.writeFileSync(STATE_FILE,JSON.stringify({lastKey:k,at:new Date().toISOString()}))}catch(e){console.error(e)} }
const logTrade=o=>{ let a=[];try{a=JSON.parse(fs.readFileSync(TRADE_LOG,'utf8'))}catch{};a.push(o);fs.writeFileSync(TRADE_LOG,JSON.stringify(a,null,2)) }
async function check(){
  let candles=await fetchCandles(); const v=validateData(candles); candles=v.clean
  const closed=candles.slice(0,-1), forming=candles[candles.length-1]
  const sig=analyse(closed,closed[closed.length-1].timestamp); const ts=new Date().toISOString()
  if(sig.skipped){ console.log(`[${ts}] WAIT · ${sig.regime} · ${sig.why}`); return }
  const live=forming.close, R=Math.abs(sig.entry-sig.sl)
  if((sig.direction==='BUY'?live<=sig.sl:live>=sig.sl)){ console.log(`[${ts}] SKIP: live past stop`); return }
  if((sig.direction==='BUY'?sig.entry-live:live-sig.entry)>0.5*R){ console.log(`[${ts}] SKIP: stale (>0.5R drift)`); return }
  const slip=+(live-sig.entry).toFixed(2)
  const barTs=closed[closed.length-1].timestamp, key=`${sig.direction}|${barTs}`
  if(key===loadKey()){ console.log(`[${ts}] already alerted this bar`); return }
  saveKey(key); logTrade({ts,live,slip,...sig})
  await sendTelegram(
`🟡 <b>GOLD M5 — ${sig.direction}</b> (score ${sig.score}/100 ${sig.tier})
Net ${sig.net} (bull ${sig.bull}/bear ${sig.bear}) · H1 ${sig.h1Trend} · ${sig.session}
Planned $${sig.entry} · live $${live} (drift ${slip>=0?'+':''}${slip})
SL $${sig.sl}  TP1 $${sig.tp1} TP2 $${sig.tp2} TP3 $${sig.tp3}
Size ${sig.posSize}
⚠️ Source ${SOURCE} — must equal your execution venue. Trust the report, not this tier.`)
  console.log(`[${ts}] ✅ ${sig.direction} net ${sig.net} · live $${live}`)
}

