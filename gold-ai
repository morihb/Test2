// ─────────────────────────────────────────────────────────────
//  MATH (fixed: SMA-seeded EMA, no rounding inside the recursion)
// ─────────────────────────────────────────────────────────────
const ema = (p, n) => {
  if (p.length < n) return p.map(() => null)
  const k = 2/(n+1)
  let e = p.slice(0, n).reduce((a,b)=>a+b,0)/n          // SMA seed (correct warmup)
  const out = new Array(n-1).fill(null)
  out.push(e)
  for (let i=n;i<p.length;i++){ e = p[i]*k + e*(1-k); out.push(e) }
  return out
}
const last = a => (a && a.length ? a[a.length-1] : null)

const rsiCalc = (p, n=14) => {
  if (p.length < n+1) return null
  let g=0,l=0
  for (let i=1;i<=n;i++){ const d=p[i]-p[i-1]; d>0?g+=d:l-=d }
  let ag=g/n, al=l/n
  for (let i=n+1;i<p.length;i++){ const d=p[i]-p[i-1]
    if (d>0){ ag=(ag*(n-1)+d)/n; al=al*(n-1)/n } else { ag=ag*(n-1)/n; al=(al*(n-1)-d)/n } }
  return +(100-100/(1+ag/(al||1e-9))).toFixed(2)
}

// ATR uses Wilder smoothing on REAL ohlc (single source guarantees it)
const atrCalc = (c, n=14) => {
  if (c.length < n+1) return null
  const tr = c.slice(1).map((v,i)=>{
    const pc=c[i].close, h=v.high, l=v.low
    return Math.max(h-l, Math.abs(h-pc), Math.abs(l-pc))
  })
  let a = tr.slice(0,n).reduce((x,y)=>x+y,0)/n
  for (let i=n;i<tr.length;i++) a = (a*(n-1)+tr[i])/n
  return a
}

const macdCalc = (p) => {
  if (p.length < 35) return {hist:null,bullCross:false,bearCross:false}
  const e12=ema(p,12), e26=ema(p,26)
  const macdLine = p.map((_,i)=> (e12[i]!=null&&e26[i]!=null) ? e12[i]-e26[i] : null).filter(v=>v!=null)
  const sig = ema(macdLine,9)
  const hist = macdLine.map((m,i)=> sig[i]!=null ? m-sig[i] : null).filter(v=>v!=null)
  const h=last(hist), ph=hist[hist.length-2]
  return { hist:+h.toFixed(2), bullCross:h>0&&ph<=0, bearCross:h<0&&ph>=0 }
}

const bbCalc = (p, n=20, m=2) => {
  if (p.length<n) return null
  const sl=p.slice(-n), mn=sl.reduce((a,b)=>a+b,0)/n
  const sd=Math.sqrt(sl.reduce((a,b)=>a+(b-mn)**2,0)/n)
  return { upper:mn+m*sd, mid:mn, lower:mn-m*sd, width:(2*m*sd)/mn }
}

const stochCalc = (c, n=14) => {
  if (c.length<n) return null
  const w=c.slice(-n)
  const H=Math.max(...w.map(v=>v.high)), L=Math.min(...w.map(v=>v.low))
  return +((c[c.length-1].close-L)/((H-L)||1e-9)*100).toFixed(2)
}

// NOTE: true VWAP needs volume the feed doesn't give. This is an SMA20.
// It is used ONLY as a slow trend reference and is NAMED honestly.
const sma20 = (c) => c.length<20 ? null : +(c.slice(-20).reduce((a,b)=>a+b.close,0)/20).toFixed(2)

// ─────────────────────────────────────────────────────────────
//  REGIME ENGINE (ADX trend strength + ATR% volatility tier)
//  This is the gate that stops trend & mean-reversion signals
//  from cancelling each other out.
// ─────────────────────────────────────────────────────────────
function adx(c, n=14){
  if (c.length < 2*n+1) return null
  const H=c.map(x=>x.high), L=c.map(x=>x.low), C=c.map(x=>x.close)
  const trs=[], pdm=[], mdm=[]
  for (let i=1;i<c.length;i++){
    const up=H[i]-H[i-1], dn=L[i-1]-L[i]
    pdm.push(up>dn && up>0 ? up : 0)
    mdm.push(dn>up && dn>0 ? dn : 0)
    trs.push(Math.max(H[i]-L[i], Math.abs(H[i]-C[i-1]), Math.abs(L[i]-C[i-1])))
  }
  const wild=(a)=>{ let s=a.slice(0,n).reduce((x,y)=>x+y,0); const o=[s]
    for(let i=n;i<a.length;i++){ s=s-s/n+a[i]; o.push(s) } return o }
  const tr=wild(trs), pd=wild(pdm), md=wild(mdm)
  const pdi=pd.map((v,i)=>100*v/(tr[i]||1e-9))
  const mdi=md.map((v,i)=>100*v/(tr[i]||1e-9))
  const dx=pdi.map((v,i)=>100*Math.abs(v-mdi[i])/((v+mdi[i])||1e-9))
  if (dx.length<n) return null
  let a=dx.slice(0,n).reduce((x,y)=>x+y,0)/n
  for (let i=n;i<dx.length;i++) a=(a*(n-1)+dx[i])/n
  return { adx:+a.toFixed(1), pdi:+last(pdi).toFixed(1), mdi:+last(mdi).toFixed(1) }
}

function marketRegime(c, price){
  const d=adx(c), atr=atrCalc(c)
  const atrPct = atr ? atr/price*100 : null
  if (!d || atrPct==null) return { regime:'unknown', adx:null, atrPct, allowTrend:true, allowMR:true }
  // volatility tiers (M5 gold): tune to YOUR backtest, do not trust these defaults
  if (atrPct < 0.04) return { regime:'low_liquidity',      ...d, atrPct, allowTrend:false, allowMR:false }
  if (atrPct > 0.55) return { regime:'volatile_expansion', ...d, atrPct, allowTrend:true,  allowMR:false } // don't fade spikes
  if (d.adx >= 25 && d.pdi > d.mdi) return { regime:'trending_bull', ...d, atrPct, allowTrend:true,  allowMR:false }
  if (d.adx >= 25 && d.mdi > d.pdi) return { regime:'trending_bear', ...d, atrPct, allowTrend:true,  allowMR:false }
  if (d.adx < 18)                   return { regime:'ranging',       ...d, atrPct, allowTrend:false, allowMR:true  }
  return { regime:'transition', ...d, atrPct, allowTrend:true, allowMR:true } // weak trend, allow both at lower weight
  // NOTE: "news/event-driven" is NOT detectable from price alone. It belongs
  // to the news filter (needs an economic-calendar API you don't yet have).
}

// ─────────────────────────────────────────────────────────────
//  SESSION / AMD  — now takes the bar's time, not wall-clock,
//  so it is correct in backtest AND ignores nothing silently.
//  (Kill-zone hours are fixed UTC; real London/NY zones shift with
//  DST — flagged as a known limitation.)
// ─────────────────────────────────────────────────────────────
function detectAMDPhase(candles, price, nowMs){
  const now = new Date(nowMs)
  const t = now.getUTCHours() + now.getUTCMinutes()/60
  const isAsian=t>=0&&t<7, isLondon=t>=7&&t<12, isNY=t>=13&&t<21
  const inSB=(t>=8&&t<9)||(t>=15&&t<16)||(t>=20&&t<21)
  const asian=candles.slice(-20,-6)
  const aH=asian.length?Math.max(...asian.map(c=>c.high)):null
  const aL=asian.length?Math.min(...asian.map(c=>c.low)):null
  const rec=candles.slice(-6)
  const rH=Math.max(...rec.map(c=>c.high)), rL=Math.min(...rec.map(c=>c.low))
  const sweptHigh=aH&&rH>aH&&price<aH, sweptLow=aL&&rL<aL&&price>aL
  let phase='accumulation', bias='neutral', judas=false
  if (isLondon){ phase='manipulation'; if(sweptLow){bias='bullish';judas=true} else if(sweptHigh){bias='bearish';judas=true} }
  else if (isNY){ phase='distribution'; if(sweptLow)bias='bullish'; else if(sweptHigh)bias='bearish' }
  const label = inSB?'Silver Bullet window'
    : isAsian?'Asian (Accumulation)' : isLondon?'London (Manipulation)' : isNY?'NY (Distribution)' : 'Off-hours'
  return { phase, bias, judas, inSB, label, bestPhase: phase==='distribution'||inSB,
           t:`${now.getUTCHours()}:${String(now.getUTCMinutes()).padStart(2,'0')} UTC` }
}

// ── structure / liquidity / displacement: kept, now fed REAL ohlc ──
function detectStructure(c, lb=3){
  const H=[],L=[]
  for (let i=lb;i<c.length-lb;i++){
    const v=c[i].close
    const lf=c.slice(i-lb,i).map(d=>d.close), rt=c.slice(i+1,i+1+lb).map(d=>d.close)
    if (v>Math.max(...lf)&&v>Math.max(...rt)) H.push({...c[i],idx:i})
    if (v<Math.min(...lf)&&v<Math.min(...rt)) L.push({...c[i],idx:i})
  }
  let bos='none', choch='none'
  if (H.length>=2&&L.length>=2){
    const rH=H[H.length-1],pH=H[H.length-2],rL=L[L.length-1],pL=L[L.length-2]
    if(rH.close>pH.close&&rL.close>pL.close)bos='bullish'
    if(rH.close<pH.close&&rL.close<pL.close)bos='bearish'
    if(bos==='bullish'&&last(c).close<rL.close)choch='bearish_choch'
    if(bos==='bearish'&&last(c).close>rH.close)choch='bullish_choch'
  }
  return { H,L, rH:H.length?H[H.length-1]:null, rL:L.length?L[L.length-1]:null, bos, choch }
}

function detectLiquiditySweep(c){
  const last5=c.slice(-5), prev=c.slice(-20,-5)
  if(!prev.length) return {sweepBull:false,sweepBear:false}
  const pH=Math.max(...prev.map(x=>x.high)), pL=Math.min(...prev.map(x=>x.low))
  let sb=false, ss=false
  for(const x of last5){ if(x.high>pH&&x.close<pH)ss=true; if(x.low<pL&&x.close>pL)sb=true }
  return { sweepBull:sb, sweepBear:ss, prevHigh:pH, prevLow:pL }
}

function detectDisplacement(c){
  if(c.length<23) return {disp:false,dir:'none',ratio:0}
  const avg=c.slice(-20,-3).reduce((a,x)=>a+(x.high-x.low),0)/17
  const x=last(c), r=x.high-x.low
  return { disp:r>avg*1.8, dir:x.close>x.open?'bullish':'bearish', ratio:r/(avg||1e-9) }
}

// ─────────────────────────────────────────────────────────────
//  WEIGHTED SCORING — 0..100, regime-gated. No fabricated win%.
// ─────────────────────────────────────────────────────────────
const WEIGHTS = { regime:25, liquidity:20, structure:20, ema:12, macd:8, osc:10, sma:5 }

function analyse(candles, nowMs){
  const price = last(candles).close
  const prices = candles.map(c=>c.close)
  const reg = marketRegime(candles, price)
  const amd = detectAMDPhase(candles, price, nowMs)
  const str = detectStructure(candles, TF.scalp.slb)
  const liq = detectLiquiditySweep(candles)
  const disp = detectDisplacement(candles)
  const e20=last(ema(prices,20)), e50=last(ema(prices,50))
  const rsi=rsiCalc(prices), macd=macdCalc(prices), bb=bbCalc(prices), st=stochCalc(candles), s20=sma20(candles)
  const atr=atrCalc(candles)

  // hard gates: no trade at all
  if (!atr || reg.regime==='low_liquidity')
    return wait('low liquidity / no ATR', reg, amd)
  if (reg.atrPct < 0.03 || reg.atrPct > 3.0)
    return wait(`ATR ${reg.atrPct?.toFixed(3)}% outside safe band`, reg, amd)

  let buy=0, sell=0
  const reasons=[]

  // regime — the heaviest, sets the playbook
  if (reg.regime==='trending_bull'){ buy+=WEIGHTS.regime; reasons.push('Regime: trending bull') }
  else if (reg.regime==='trending_bear'){ sell+=WEIGHTS.regime; reasons.push('Regime: trending bear') }
  else if (reg.regime==='volatile_expansion'){ reasons.push('Regime: volatile expansion (trend-follow only, wider stop)') }
  else if (reg.regime==='ranging'){ reasons.push('Regime: ranging (mean-reversion only)') }

  // liquidity sweep (high weight) — direction-agnostic to regime
  if (liq.sweepBull){ buy+=WEIGHTS.liquidity; reasons.push(`Sell-side liq swept @${liq.prevLow?.toFixed(2)} then reclaimed`) }
  if (liq.sweepBear){ sell+=WEIGHTS.liquidity; reasons.push(`Buy-side liq swept @${liq.prevHigh?.toFixed(2)} then rejected`) }

  // structure (high weight)
  if (str.bos==='bullish'||str.choch==='bullish_choch'){ buy+=WEIGHTS.structure; reasons.push('Bullish BOS/CHoCH') }
  if (str.bos==='bearish'||str.choch==='bearish_choch'){ sell+=WEIGHTS.structure; reasons.push('Bearish BOS/CHoCH') }

  // trend indicators — ONLY counted when regime allows trend
  if (reg.allowTrend){
    if (e20&&e50&&e20>e50&&price>e20){ buy+=WEIGHTS.ema; reasons.push('EMA20>EMA50, price above') }
    if (e20&&e50&&e20<e50&&price<e20){ sell+=WEIGHTS.ema; reasons.push('EMA20<EMA50, price below') }
    if (macd.hist!=null && macd.hist>0){ buy+=WEIGHTS.macd }
    if (macd.hist!=null && macd.hist<0){ sell+=WEIGHTS.macd }
    if (s20&&price>s20) buy+=WEIGHTS.sma; else if (s20&&price<s20) sell+=WEIGHTS.sma
  }

  // oscillators (mean-reversion) — ONLY when regime allows MR
  if (reg.allowMR && rsi!=null && st!=null && bb){
    const atLow=price<=bb.lower, atHigh=price>=bb.upper
    if (atLow && rsi<35 && st<25){ buy+=WEIGHTS.osc; reasons.push(`Oversold reclaim (RSI ${rsi}, Stoch ${st})`) }
    if (atHigh && rsi>65 && st>75){ sell+=WEIGHTS.osc; reasons.push(`Overbought rejection (RSI ${rsi}, Stoch ${st})`) }
  }

  // Elliott Wave: LOGGED ONLY. It does not affect the score or confidence.
  // (Removed from decisioning per audit — it manufactured false confidence.)

  const total = Object.values(WEIGHTS).reduce((a,b)=>a+b,0)
  const dirBuy = buy>=sell
  const raw = Math.max(buy,sell)
  const score = Math.round(raw/total*100)
  const dir = score>=45 ? (dirBuy?'BUY':'SELL') : 'WAIT'
  // tiers are DESCRIPTIVE ONLY until the backtest attaches a real win rate
  const tier = score>=70?'A':score>=55?'B':score>=45?'C':'—'

  if (dir==='WAIT')
    return wait(`score ${score}/100 below threshold`, reg, amd, {score})

  // ── risk: ATR stop, regime-aware multiple, guards against bad placement ──
  const stopMult = reg.regime==='volatile_expansion' ? 2.2 : 1.5
  let entry=price, sl, tp1, tp2, tp3
  if (dir==='BUY'){
    let base = liq.sweepBull&&liq.prevLow ? liq.prevLow-atr*0.3
             : str.rL ? str.rL.close-atr*0.3 : price-atr*stopMult
    if (base>=entry) base = price-atr*stopMult
    sl=+Math.max(base, price-atr*5).toFixed(2)
    const r=entry-sl; tp1=+(entry+r*1.5).toFixed(2); tp2=+(entry+r*2.5).toFixed(2); tp3=+(entry+r*4).toFixed(2)
  } else {
    let base = liq.sweepBear&&liq.prevHigh ? liq.prevHigh+atr*0.3
             : str.rH ? str.rH.close+atr*0.3 : price+atr*stopMult
    if (base<=entry) base = price+atr*stopMult
    sl=+Math.min(base, price+atr*5).toFixed(2)
    const r=sl-entry; tp1=+(entry-r*1.5).toFixed(2); tp2=+(entry-r*2.5).toFixed(2); tp3=+(entry-r*4).toFixed(2)
  }

  // volatility-adjusted sizing (XAUUSD 100oz contract → $100 per $1 per 1.0 lot)
  const riskUSD = ACCT*(RISK/100)
  const lots = (riskUSD/(Math.abs(entry-sl)*100))
  return {
    direction:dir, score, tier, regime:reg.regime, adx:reg.adx, atrPct:+reg.atrPct.toFixed(3),
    session:amd.label, entry:+entry.toFixed(2), sl, tp1, tp2, tp3,
    rr:`1:${Math.abs((tp2-entry)/(entry-sl)).toFixed(1)}`,
    posSize:`${lots.toFixed(3)} lots · $${riskUSD.toFixed(0)} max risk`,
    inv: dir==='BUY'?`5m close below $${sl}`:`5m close above $${sl}`,
    reasons, skipped:false
  }
}
function wait(why, reg, amd, extra={}){
  return { direction:'WAIT', skipped:true, why, regime:reg?.regime, session:amd?.label, ...extra }
}

