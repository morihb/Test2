const mode=process.argv[2]||'check'
if (mode==='backtest'){
  const c=await fetchCandles()
  console.log(`Backtesting ${c.length} M5 bars (~${(c.length*5/60/24).toFixed(0)}d), spread $${SPREAD}, slippage $${SLIPPAGE}/fill\n`)
  console.log(JSON.stringify(backtest(c), null, 2))
} else {
  await check()
}
