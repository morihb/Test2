  if(!res.ok) console.error('Telegram error',res.status,await res.text())
}
const loadKey=()=>{ try{return JSON.parse(fs.readFileSync(STATE_FILE,'utf8')).lastKey}catch{return null} }
const saveKey=k=>{ try{fs.writeFileSync(STATE_FILE,JSON.stringify({lastKey:k,at:new Date().toISOString()}))}catch(e){console.error(e)} }
const logTrade=o=>{ let a=[]; try{a=JSON.parse(fs.readFileSync(TRADE_LOG,'utf8'))}catch{} ; a.push(o); fs.writeFileSync(TRADE_LOG,JSON.stringify(a,null,2)) }

async function check(){
  const candles=await fetchCandles()
  // do NOT fabricate a live bar; analyse the last CLOSED bar
  const sig=analyse(candles.slice(0,-1), candles[candles.length-2].timestamp)
  const ts=new Date().toISOString()
  if(sig.skipped){ console.log(`[${ts}] WAIT · ${sig.regime} · ${sig.why}`); return }
  const barTs=candles[candles.length-2].timestamp
  const key=`${sig.direction}|${barTs}`
  if(key===loadKey()){ console.log(`[${ts}] ${sig.direction} already alerted this bar`); return }
  saveKey(key); logTrade({ts,...sig})
  await sendTelegram(
`🟡 <b>GOLD M5 — ${sig.direction}</b>  (score ${sig.score}/100, tier ${sig.tier})
Regime: ${sig.regime} (ADX ${sig.adx})  ·  ${sig.session}
Entry $${sig.entry}  SL $${sig.sl}
TP1 $${sig.tp1}  TP2 $${sig.tp2}  TP3 $${sig.tp3}   R:R ${sig.rr}
Size: ${sig.posSize}
Why: ${sig.reasons.join('; ')}
Invalid: ${sig.inv}

⚠️ Tier is descriptive only. Win rate must come from backtest, not this alert.`)
  console.log(`[${ts}] ✅ ${sig.direction} score ${sig.score}`)
}

